# =====================================================
# Lead & Bid Manager — Environment Variables
# =====================================================

# Supabase Project URL (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous / Publishable Key (required — safe to expose in browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# Supabase Service Role Key (required for server-side user invitations / admin functions)
SUPABASE_SECRET_KEY=your-service-role-key-here

# Optional: Public site URL for invitation redirect callback (defaults to current origin if omitted)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
