# Basic login for the app (set these in Vercel Project Settings -> Environment Variables)
APP_USER=admin
APP_PASSWORD=change-this-password

# These are added AUTOMATICALLY by Vercel when you connect an Upstash Redis /
# Vercel KV storage to this project. You do NOT need to set them by hand.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
