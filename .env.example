# =====================================================
# Lead & Bid Manager — Environment Variables
# =====================================================

# Local Supabase Development URL (or https://your-project.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase Anonymous / Publishable Key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# Supabase Service Role Key (required for server-side user invitations & admin functions)
SUPABASE_SECRET_KEY=your-service-role-key-here

# Site URL for invitation redirect callbacks
NEXT_PUBLIC_SITE_URL=http://localhost:3000
